#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Ищет заказ по идентификатору на стороне маркетплейса.
//
// Параметры:
//  Идентификатор - Строка - идентификатор заказа маркетплейса.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказМаркетплейса, Неопределено - найденный заказ.
//
Функция НайтиПоИдентификатору(Идентификатор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказМаркетплейса КАК Заказ
	|ГДЕ
	|	Заказ.ИдентификаторЗаказа = &Идентификатор
	|	И НЕ Заказ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Код статуса заказа для внешних систем.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыЗаказов
//
// Возвращаемое значение:
//  Строка - код статуса ("awaiting_packaging" и т.п.), пустая строка для пустого статуса.
//
Функция КодСтатуса(Статус) Экспорт

	Для Каждого КлючИЗначение Из СоответствиеСтатусов() Цикл
		Если КлючИЗначение.Значение = Статус Тогда
			Возврат КлючИЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Статус заказа по коду внешней системы.
//
// Параметры:
//  Код - Строка - код статуса.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыЗаказов, Неопределено - если код неизвестен.
//
Функция СтатусПоКоду(Код) Экспорт

	Возврат СоответствиеСтатусов().Получить(НРег(СокрЛП(Код)));

КонецФункции

// Признак конечного статуса: из него заказ уже не переводится.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыЗаказов
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКонечныйСтатус(Статус) Экспорт

	Возврат Статус = Перечисления.СтатусыЗаказов.Доставлен
		Или Статус = Перечисления.СтатусыЗаказов.Отменен;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоответствиеСтатусов()

	Статусы = Новый Соответствие;
	Статусы.Вставить("new", Перечисления.СтатусыЗаказов.Новый);
	Статусы.Вставить("awaiting_packaging", Перечисления.СтатусыЗаказов.ОжидаетСборки);
	Статусы.Вставить("delivering", Перечисления.СтатусыЗаказов.Доставляется);
	Статусы.Вставить("delivered", Перечисления.СтатусыЗаказов.Доставлен);
	Статусы.Вставить("cancelled", Перечисления.СтатусыЗаказов.Отменен);

	Возврат Статусы;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
