#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Состав заказа с маркетплейса задает покупатель: в 1С его не меняют, только статус.
	ЗаказМаркетплейса = ЗначениеЗаполнено(Объект.ИдентификаторЗаказа) И Не Параметры.Ключ.Пустая();
	Элементы.ИдентификаторЗаказа.ТолькоПросмотр = ЗаказМаркетплейса;
	Элементы.Товары.ТолькоПросмотр = ЗаказМаркетплейса;

	УстановитьДоступностьОтправкиСтатуса(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	УстановитьДоступностьОтправкиСтатуса(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСтатус(Команда)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите заказ.'"));
		Возврат;
	КонецЕсли;

	Ошибки = ОтправитьСтатусНаСервере(Объект.Ссылка);
	Если Ошибки.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Статус отправлен на маркетплейс'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Статус не отправлен, заказ поставлен в очередь повторной отправки:
			|%1'"), СтрСоединить(Ошибки, Символы.ПС)));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(СтрокаТоваров)

	СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьСтатусНаСервере(Знач Заказ)

	// Токен маркетплейса и журнал обмена пользователю недоступны - обмен выполняется от имени системы.
	УстановитьПривилегированныйРежим(Истина); // BSLLS:SetPrivilegedMode-off
	Возврат ОбменСМаркетплейсом.ОтправитьСтатусЗаказа(Заказ).Ошибки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьОтправкиСтатуса(Форма)

	Форма.Элементы.ФормаОтправитьСтатус.Доступность = ЗначениеЗаполнено(Форма.Объект.Ссылка)
		И ЗначениеЗаполнено(Форма.Объект.ИдентификаторЗаказа);

КонецПроцедуры

#КонецОбласти
