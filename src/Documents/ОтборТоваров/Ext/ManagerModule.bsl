#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Распределяет товары заказа по ячейкам хранения. Ячейки обходятся по порядку обхода,
// из каждой берется сколько есть, пока не наберется заказанное количество. Зона приемки не используется:
// товар из нее сначала размещают.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказМаркетплейса
//
// Возвращаемое значение:
//  Структура:
//   * Товары - ТаблицаЗначений - Номенклатура, Ячейка, Количество в порядке обхода.
//   * Ошибки - Массив из Строка - товары, которых в ячейках хранения не хватает.
//
Функция РаспределениеПоЯчейкам(Заказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыЗаказа.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТЗаказано
	|ИЗ
	|	Документ.ЗаказМаркетплейса.Товары КАК ТоварыЗаказа
	|ГДЕ
	|	ТоварыЗаказа.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыЗаказа.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказано.Номенклатура КАК Номенклатура,
	|	ВТЗаказано.Количество КАК Количество
	|ИЗ
	|	ВТЗаказано КАК ВТЗаказано
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка <> &ЗонаПриемки
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТЗаказано.Номенклатура КАК Номенклатура
	|					ИЗ
	|						ВТЗаказано КАК ВТЗаказано)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Номенклатура КАК Номенклатура,
	|	ВТОстатки.Ячейка КАК Ячейка,
	|	Ячейки.ПорядокОбхода КАК ПорядокОбхода,
	|	ВТОстатки.Количество КАК Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Ячейки КАК Ячейки
	|		ПО ВТОстатки.Ячейка = Ячейки.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ячейки.ПорядокОбхода,
	|	Ячейки.Наименование";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ЗонаПриемки", Справочники.Ячейки.ЗонаПриемки);

	Результаты = Запрос.ВыполнитьПакет();
	Заказано = Результаты[1].Выгрузить();
	Остатки = Результаты[3].Выгрузить();

	Результат = Новый Структура;
	Результат.Вставить("Товары", НоваяТаблицаТоваров());
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Товары.Колонки.Добавить("ПорядокОбхода", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаЗаказа Из Заказано Цикл
		Осталось = СтрокаЗаказа.Количество;
		Для Каждого СтрокаОстатка Из Остатки.НайтиСтроки(Новый Структура("Номенклатура", СтрокаЗаказа.Номенклатура)) Цикл
			Взять = Мин(Осталось, СтрокаОстатка.Количество);
			СтрокаТоваров = Результат.Товары.Добавить();
			СтрокаТоваров.Номенклатура = СтрокаЗаказа.Номенклатура;
			СтрокаТоваров.Ячейка = СтрокаОстатка.Ячейка;
			СтрокаТоваров.ПорядокОбхода = СтрокаОстатка.ПорядокОбхода;
			СтрокаТоваров.Количество = Взять;
			Осталось = Осталось - Взять;
			Если Осталось = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Осталось > 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'В ячейках хранения не хватает товара %1: %2'"),
				СтрокаЗаказа.Номенклатура, Осталось));
		КонецЕсли;
	КонецЦикла;

	// Сборщик идет по складу один раз: строки в порядке обхода ячеек, а не в порядке заказа.
	Результат.Товары.Сортировать("ПорядокОбхода, Ячейка");
	Результат.Товары.Колонки.Удалить("ПорядокОбхода");

	Возврат Результат;

КонецФункции

// Ищет отбор по заказу (не помеченный на удаление).
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказМаркетплейса
//  Исключить - ДокументСсылка.ОтборТоваров - текущий документ, который не нужно учитывать.
//
// Возвращаемое значение:
//  ДокументСсылка.ОтборТоваров, Неопределено
//
Функция ОтборПоЗаказу(Заказ, Исключить = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Отбор.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтборТоваров КАК Отбор
	|ГДЕ
	|	Отбор.Заказ = &Заказ
	|	И Отбор.Ссылка <> &Исключить
	|	И НЕ Отбор.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Отбор.Проведен УБЫВ,
	|	Отбор.Дата УБЫВ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Исключить", Исключить);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Создает и проводит отбор по заказу.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказМаркетплейса
//
// Возвращаемое значение:
//  ДокументОбъект.ОтборТоваров
//
// Исключения:
//  Если провести не удалось - с текстом сообщений проверки (нехватка товара, неподходящий статус заказа).
//
Функция СоздатьПоЗаказу(Заказ) Экспорт

	ПолучитьСообщенияПользователю(Истина);

	Отбор = Документы.ОтборТоваров.СоздатьДокумент();
	Отбор.Дата = ТекущаяДатаСеанса();
	Отбор.Заполнить(Заказ);

	// При программной записи проверка заполнения сама не выполняется.
	Если Не Отбор.ПроверитьЗаполнение() Тогда
		ВызватьИсключение ТекстСообщений();
	КонецЕсли;

	Попытка
		Отбор.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ТекстСообщений();
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ВызватьИсключение;
		КонецЕсли;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат Отбор;

КонецФункции

// Строки листа отбора в порядке обхода ячеек.
//
// Параметры:
//  Отбор - ДокументСсылка.ОтборТоваров
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ячейка, Артикул, Номенклатура, Количество.
//
Функция СтрокиЛистаОтбора(Отбор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ячейка КАК Ячейка,
	|	Ячейки.Наименование КАК АдресЯчейки,
	|	Товар.Артикул КАК Артикул,
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ОтборТоваров.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Ячейки КАК Ячейки
	|		ПО Товары.Ячейка = Ячейки.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товар
	|		ПО Товары.Номенклатура = Товар.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ячейка,
	|	Ячейки.Наименование,
	|	Ячейки.ПорядокОбхода,
	|	Товар.Артикул,
	|	Товары.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ячейки.ПорядокОбхода,
	|	АдресЯчейки,
	|	Артикул";
	Запрос.УстановитьПараметр("Ссылка", Отбор);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Печатная форма «Лист отбора».
//
// Параметры:
//  Отборы - Массив из ДокументСсылка.ОтборТоваров
//
// Возвращаемое значение:
//  ТабличныйДокумент - листы отбора, каждый с новой страницы.
//
Функция ПечатьЛистаОтбора(Отборы) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ОтборТоваров_ЛистОтбора";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;

	Макет = ПолучитьМакет("ЛистОтбора");

	Для Каждого Отбор Из Отборы Цикл

		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		Шапка = РеквизитыШапки(Отбор);

		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(Шапка);
		Область.Параметры.ТекстЗаголовка = СтрШаблон(НСтр("ru = 'Лист отбора № %1 от %2'"),
			Шапка.Номер, Формат(Шапка.Дата, "ДЛФ=D"));
		ТабличныйДокумент.Вывести(Область);

		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));

		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		Строки = СтрокиЛистаОтбора(Отбор);
		НомерСтроки = 0;
		Для Каждого СтрокаЛиста Из Строки Цикл
			НомерСтроки = НомерСтроки + 1;
			ОбластьСтроки.Параметры.Заполнить(СтрокаЛиста);
			ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
			ТабличныйДокумент.Вывести(ОбластьСтроки);
		КонецЦикла;

		Область = Макет.ПолучитьОбласть("Итого");
		Область.Параметры.Количество = Строки.Итог("Количество");
		Область.Параметры.ЧислоСтрок = Строки.Количество();
		ТабличныйДокумент.Вывести(Область);

		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Подписи"));

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

Функция НоваяТаблицаТоваров()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Ячейка", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

Функция РеквизитыШапки(Отбор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отбор.Номер КАК Номер,
	|	Отбор.Дата КАК Дата,
	|	Отбор.Заказ КАК Заказ,
	|	ЗаказМаркетплейса.ИдентификаторЗаказа КАК ИдентификаторЗаказа
	|ИЗ
	|	Документ.ОтборТоваров КАК Отбор
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказМаркетплейса КАК ЗаказМаркетплейса
	|		ПО Отбор.Заказ = ЗаказМаркетплейса.Ссылка
	|ГДЕ
	|	Отбор.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Отбор);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Реквизиты = Новый Структура("Номер, Дата, Заказ, ИдентификаторЗаказа");
	ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
	Возврат Реквизиты;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
