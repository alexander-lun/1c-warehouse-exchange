#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет товары по заказу: распределяет количество по ячейкам хранения в порядке обхода.
// Если товара в ячейках хранения не хватает, выводит сообщения и заполняет то, что есть.
//
Процедура ЗаполнитьПоЗаказу() Экспорт

	Товары.Очистить();
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Распределение = Документы.ОтборТоваров.РаспределениеПоЯчейкам(Заказ);
	Для Каждого Строка Из Распределение.Товары Цикл
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), Строка);
	КонецЦикла;

	Для Каждого ТекстОшибки Из Распределение.Ошибки Цикл
		СообщитьПользователю(ТекстОшибки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказМаркетплейса") Тогда
		Заказ = ДанныеЗаполнения;
		ЗаполнитьПоЗаказу();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Документы.ЗаказМаркетплейса.РеквизитыДляОтбора(Заказ);
	Если Не Реквизиты.Проведен Или Реквизиты.Статус <> Перечисления.СтатусыЗаказов.ОжидаетСборки Тогда
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'Отбирать можно только проведенный заказ в статусе ""%1"" (сейчас: %2)'"),
			Перечисления.СтатусыЗаказов.ОжидаетСборки, Реквизиты.Статус), "Заказ", Отказ);
	КонецЕсли;

	ПроверитьСоответствиеЗаказу(Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Или РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	// Заказ собирают один раз. Блокировка заказа не дает двум сборщикам одновременно
	// провести отборы по нему: второй дождется первого и увидит его отбор.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ.ЗаказМаркетплейса");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Заказ);
	Блокировка.Заблокировать();

	ДругойОтбор = Документы.ОтборТоваров.ОтборПоЗаказу(Заказ, Ссылка);
	Если ДругойОтбор <> Неопределено Тогда
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'По заказу уже есть отбор %1'"), ДругойОтбор), "Заказ", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ТоварыВЯчейках.Записывать = Истина;

	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ТоварыВЯчейках.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Ячейка = СтрокаТоваров.Ячейка;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Количество = СтрокаТоваров.Количество;
	КонецЦикла;

	Движения.ТоварыВЯчейках.БлокироватьДляИзменения = Истина;
	Движения.Записать();

	РегистрыНакопления.ТоварыВЯчейках.ПроверитьОстатки(Движения.ТоварыВЯчейках, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отобрать нужно ровно то, что заказано: ни недобора, ни лишнего товара.
//
// Параметры:
//  Отказ - Булево
//
Процедура ПроверитьСоответствиеЗаказу(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отбор.Номенклатура КАК Номенклатура,
	|	Отбор.Количество КАК Количество
	|ПОМЕСТИТЬ ВТОтбор
	|ИЗ
	|	&Товары КАК Отбор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Разница.Номенклатура КАК Номенклатура,
	|	СУММА(Разница.Заказано) КАК Заказано,
	|	СУММА(Разница.Отобрано) КАК Отобрано
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|		ТоварыЗаказа.Количество КАК Заказано,
	|		0 КАК Отобрано
	|	ИЗ
	|		Документ.ЗаказМаркетплейса.Товары КАК ТоварыЗаказа
	|	ГДЕ
	|		ТоварыЗаказа.Ссылка = &Заказ
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВТОтбор.Номенклатура,
	|		0,
	|		ВТОтбор.Количество
	|	ИЗ
	|		ВТОтбор КАК ВТОтбор) КАК Разница
	|
	|СГРУППИРОВАТЬ ПО
	|	Разница.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(Разница.Заказано) <> СУММА(Разница.Отобрано)";
	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить(, "Номенклатура, Количество"));
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'Товар %1: заказано %2, в отборе %3'"),
			Выборка.Номенклатура, Выборка.Заказано, Выборка.Отобрано), "Товары", Отказ);
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьПользователю(Текст, Поле = "", Отказ = Неопределено)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
	КонецЕсли;
	Сообщение.Сообщить();

	Если Отказ <> Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
