#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Подбирает ячейки хранения для всего товара, лежащего в зоне приемки.
// Товар кладется в ячейку, где он уже хранится (первую по порядку обхода), а новый товар -
// в первую свободную ячейку. Вместимость ячеек не учитывается.
//
// Возвращаемое значение:
//  Структура:
//   * Товары - ТаблицаЗначений - строки для табличной части Товары:
//     ** Номенклатура - СправочникСсылка.Номенклатура
//     ** ЯчейкаОтправитель - СправочникСсылка.Ячейки
//     ** ЯчейкаПолучатель - СправочникСсылка.Ячейки
//     ** Количество - Число
//   * Ошибки - Массив из Строка - товары, для которых не нашлось ячейки.
//
Функция ТоварыДляРазмещенияИзЗоныПриемки() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТПриемка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Ячейка = &ЗонаПриемки) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстаткиХранения
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Ячейка <> &ЗонаПриемки) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПриемка.Номенклатура КАК Номенклатура,
	|	ВТПриемка.Количество КАК Количество
	|ИЗ
	|	ВТПриемка КАК ВТПриемка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО ВТПриемка.Номенклатура = Товары.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстаткиХранения.Номенклатура КАК Номенклатура,
	|	ВТОстаткиХранения.Ячейка КАК Ячейка
	|ИЗ
	|	ВТОстаткиХранения КАК ВТОстаткиХранения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПриемка КАК ВТПриемка
	|		ПО ВТОстаткиХранения.Номенклатура = ВТПриемка.Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Ячейки КАК Ячейки
	|		ПО ВТОстаткиХранения.Ячейка = Ячейки.Ссылка
	|ГДЕ
	|	НЕ Ячейки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ячейки.ПорядокОбхода,
	|	Ячейки.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ячейки.Ссылка КАК Ячейка
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиХранения КАК ВТОстаткиХранения
	|		ПО Ячейки.Ссылка = ВТОстаткиХранения.Ячейка
	|ГДЕ
	|	Ячейки.Ссылка <> &ЗонаПриемки
	|	И НЕ Ячейки.ПометкаУдаления
	|	И ВТОстаткиХранения.Ячейка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ячейки.ПорядокОбхода,
	|	Ячейки.Наименование";
	Запрос.УстановитьПараметр("ЗонаПриемки", Справочники.Ячейки.ЗонаПриемки);

	Результаты = Запрос.ВыполнитьПакет();
	Приемка = Результаты[2].Выгрузить();
	ЗанятыеЯчейки = Результаты[3].Выгрузить();
	СвободныеЯчейки = Результаты[4].Выгрузить().ВыгрузитьКолонку("Ячейка");

	Результат = Новый Структура;
	Результат.Вставить("Товары", НоваяТаблицаТоваров());
	Результат.Вставить("Ошибки", Новый Массив);

	ИндексСвободной = 0;
	Для Каждого СтрокаПриемки Из Приемка Цикл

		НайденнаяЯчейка = ЗанятыеЯчейки.Найти(СтрокаПриемки.Номенклатура, "Номенклатура");
		Если НайденнаяЯчейка <> Неопределено Тогда
			ЯчейкаПолучатель = НайденнаяЯчейка.Ячейка;
		ИначеЕсли ИндексСвободной < СвободныеЯчейки.Количество() Тогда
			ЯчейкаПолучатель = СвободныеЯчейки[ИндексСвободной];
			ИндексСвободной = ИндексСвободной + 1;
		Иначе
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Нет свободной ячейки для товара %1'"), СтрокаПриемки.Номенклатура));
			Продолжить;
		КонецЕсли;

		СтрокаТоваров = Результат.Товары.Добавить();
		СтрокаТоваров.Номенклатура = СтрокаПриемки.Номенклатура;
		СтрокаТоваров.ЯчейкаОтправитель = Справочники.Ячейки.ЗонаПриемки;
		СтрокаТоваров.ЯчейкаПолучатель = ЯчейкаПолучатель;
		СтрокаТоваров.Количество = СтрокаПриемки.Количество;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаТоваров()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("ЯчейкаОтправитель", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	Таблица.Колонки.Добавить("ЯчейкаПолучатель", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
