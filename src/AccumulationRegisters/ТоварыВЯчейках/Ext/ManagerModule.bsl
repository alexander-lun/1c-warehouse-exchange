#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Проверяет, что после записи движений документа в ячейках не возникло отрицательных остатков.
// Вызывается после записи движений с БлокироватьДляИзменения = Истина: проверяется текущий остаток,
// поэтому параллельно проведенные документы видят движения друг друга.
//
// Параметры:
//  Движения - РегистрНакопленияНаборЗаписей.ТоварыВЯчейках - записанные движения документа.
//  Отказ - Булево - устанавливается при нехватке товара в ячейке.
//
Процедура ПроверитьОстатки(Движения, Отказ) Экспорт

	Ключи = Движения.Выгрузить(, "Ячейка, Номенклатура");
	Ключи.Свернуть("Ячейка, Номенклатура");
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Ячейка КАК Ячейка,
	|	Ключи.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ячейка,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	-Остатки.КоличествоОстаток КАК Нехватка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			(Ячейка, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТКлючи.Ячейка КАК Ячейка,
	|					ВТКлючи.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТКлючи КАК ВТКлючи)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Ключи", Ключи);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'В ячейке %1 не хватает товара %2: %3'"),
			Выборка.Ячейка, Выборка.Номенклатура, Выборка.Нехватка);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
