#Область ПрограммныйИнтерфейс

// Загружает новые и измененные заказы маркетплейса.
// Заказы сопоставляются по идентификатору, поэтому повторная загрузка не создает дублей.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатОбмена.
//
Функция ЗагрузитьЗаказы() Экспорт

	Результат = НовыйРезультатОбмена();

	Попытка
		Настройки = НастройкиПодключения();
		ЗагрузитьЗаказыСервиса(Настройки, Результат);
	Исключение
		Результат.Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписатьВЖурнал(Перечисления.НаправленияОбмена.Загрузка, НСтр("ru = 'Загрузка заказов'"), Результат);
	Возврат Результат;

КонецФункции

// Выгружает на маркетплейс остатки всех товаров с заполненным артикулом.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатОбмена.
//
Функция ВыгрузитьОстатки() Экспорт

	Результат = НовыйРезультатОбмена();

	Попытка
		Настройки = НастройкиПодключения();
		Остатки = ОстаткиДляВыгрузки();
		Если Остатки.Количество() > 0 Тогда
			Ответ = ВыполнитьЗапрос(Настройки, "POST", "/v1/stocks", Остатки);
			Результат.Обработано = РаботаСJSON.Свойство(Ответ, "updated", 0);
			Для Каждого Ошибка Из РаботаСJSON.Свойство(Ответ, "errors", Новый Массив) Цикл
				Результат.Ошибки.Добавить(СтрШаблон("%1: %2",
					РаботаСJSON.Свойство(Ошибка, "offer_id"), РаботаСJSON.Свойство(Ошибка, "error")));
			КонецЦикла;
		КонецЕсли;
	Исключение
		Результат.Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписатьВЖурнал(Перечисления.НаправленияОбмена.Выгрузка, НСтр("ru = 'Выгрузка остатков'"), Результат);
	Возврат Результат;

КонецФункции

// Передает на маркетплейс текущий статус заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказМаркетплейса
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатОбмена.
//
Функция ОтправитьСтатусЗаказа(Заказ) Экспорт

	Результат = НовыйРезультатОбмена();
	ОтправитьСтатус(Заказ, Результат);

	ЗаписатьВЖурнал(Перечисления.НаправленияОбмена.Выгрузка, НСтр("ru = 'Отправка статуса заказа'"), Результат);
	Возврат Результат;

КонецФункции

// Повторно отправляет статусы, которые не удалось передать раньше (регистр ОчередьОтправкиСтатусов).
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатОбмена.
//
Функция ОтправитьОжидающиеСтатусы() Экспорт

	Результат = НовыйРезультатОбмена();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.ОчередьОтправкиСтатусов КАК Очередь
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаПоследнейПопытки";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтправитьСтатус(Выборка.Заказ, Результат);
	КонецЦикла;

	ЗаписатьВЖурнал(Перечисления.НаправленияОбмена.Выгрузка, НСтр("ru = 'Повторная отправка статусов'"), Результат);
	Возврат Результат;

КонецФункции

// Обработчик регламентного задания ЗагрузкаЗаказовМаркетплейса.
//
Процедура ЗагрузкаЗаказовРегламент() Экспорт

	Если ПустаяСтрока(Константы.АдресСервисаМаркетплейса.Получить()) Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьЗаказы();
	ОтправитьОжидающиеСтатусы();
	ВыгрузитьОстатки();

КонецПроцедуры

// Результат операции обмена.
//
// Возвращаемое значение:
//  Структура:
//   * Обработано - Число - сколько объектов обработано успешно.
//   * Создано - Число
//   * Обновлено - Число
//   * Пропущено - Число - объекты без изменений.
//   * Ошибки - Массив из Строка
//
Функция НовыйРезультатОбмена() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибки", Новый Массив);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗагрузкаЗаказов

Процедура ЗагрузитьЗаказыСервиса(Настройки, Результат)

	ЗагруженоПо = Константы.ДатаПоследнейЗагрузкиЗаказов.Получить();

	Путь = "/v1/orders";
	Если ЗначениеЗаполнено(ЗагруженоПо) Тогда
		Путь = Путь + "?since=" + КодироватьСтроку(
			ЗаписатьДатуJSON(ЗагруженоПо, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата),
			СпособКодированияСтроки.КодировкаURL);
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Настройки, "GET", Путь);

	// Сервис отдает заказы, измененные начиная с отметки (включительно), по возрастанию даты изменения.
	// Отметку сдвигаем только до первого заказа с ошибкой, чтобы он попал в следующую загрузку.
	НоваяОтметка = ЗагруженоПо;
	БылаОшибка = Ложь;

	Для Каждого ДанныеЗаказа Из РаботаСJSON.Свойство(Ответ, "orders", Новый Массив) Цикл

		ДатаИзменения = РаботаСJSON.ДатаИзСтроки(РаботаСJSON.Свойство(ДанныеЗаказа, "updated_at"));

		Попытка
			Действие = ЗагрузитьЗаказ(ДанныеЗаказа);
			Результат.Обработано = Результат.Обработано + 1;
			Результат[Действие] = Результат[Действие] + 1;
		Исключение
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Заказ %1: %2'"),
				РаботаСJSON.Свойство(ДанныеЗаказа, "order_id"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Если Не БылаОшибка И ЗначениеЗаполнено(ДатаИзменения) Тогда
				НоваяОтметка = Макс(ЗагруженоПо, ДатаИзменения);
			КонецЕсли;
			БылаОшибка = Истина;
			Продолжить;
		КонецПопытки;

		Если Не БылаОшибка Тогда
			НоваяОтметка = Макс(НоваяОтметка, ДатаИзменения);
		КонецЕсли;

	КонецЦикла;

	Если НоваяОтметка <> ЗагруженоПо Тогда
		Константы.ДатаПоследнейЗагрузкиЗаказов.Установить(НоваяОтметка);
	КонецЕсли;

КонецПроцедуры

// Создает или обновляет заказ по данным маркетплейса.
//
// Параметры:
//  ДанныеЗаказа - Соответствие - заказ в формате API маркетплейса.
//
// Возвращаемое значение:
//  Строка - имя счетчика результата: "Создано", "Обновлено" или "Пропущено".
//
Функция ЗагрузитьЗаказ(ДанныеЗаказа)

	Идентификатор = Строка(РаботаСJSON.Свойство(ДанныеЗаказа, "order_id", ""));
	Если ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан идентификатор заказа'");
	КонецЕсли;

	КодСтатуса = РаботаСJSON.Свойство(ДанныеЗаказа, "status", "");
	Статус = Документы.ЗаказМаркетплейса.СтатусПоКоду(КодСтатуса);
	Если Статус = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный статус ""%1""'"), КодСтатуса);
	КонецЕсли;

	Ссылка = Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Идентификатор);

	Если Ссылка = Неопределено Тогда
		Заказ = Документы.ЗаказМаркетплейса.СоздатьДокумент();
		Заказ.Дата = ТекущаяДатаСеанса();
		Заказ.ИдентификаторЗаказа = Идентификатор;
		ЗаполнитьТоварыЗаказа(Заказ, РаботаСJSON.Свойство(ДанныеЗаказа, "items", Новый Массив));
		Действие = "Создано";
	Иначе
		Реквизиты = ОбщиеРеквизитыЗаказа(Ссылка);
		Если Реквизиты.Статус = Статус И Реквизиты.Проведен Тогда
			Возврат "Пропущено";
		КонецЕсли;
		Заказ = Ссылка.ПолучитьОбъект();
		Если Не Реквизиты.Проведен Тогда
			// Резерв возникает в момент проведения, а не в момент первой попытки загрузки.
			Заказ.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Действие = "Обновлено";
	КонецЕсли;

	Заказ.Статус = Статус;
	Попытка
		ЗаписатьЗаказ(Заказ);
	Исключение
		// Заказ мог создать параллельный сеанс загрузки - тогда это не ошибка.
		Если Заказ.ЭтоНовый() И Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Идентификатор) <> Неопределено Тогда
			Возврат "Пропущено";
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	// Статус пришел с маркетплейса - отправлять ему прежний статус из очереди уже не нужно.
	УдалитьИзОчереди(Заказ.Ссылка);

	Возврат Действие;

КонецФункции

Процедура ЗаполнитьТоварыЗаказа(Заказ, Позиции)

	Если Позиции.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заказе нет товаров'");
	КонецЕсли;

	Для Каждого Позиция Из Позиции Цикл

		Артикул = Строка(РаботаСJSON.Свойство(Позиция, "offer_id", ""));
		Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найден товар с артикулом ""%1""'"), Артикул);
		КонецЕсли;

		СтрокаТоваров = Заказ.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Номенклатура;
		СтрокаТоваров.Количество = РаботаСJSON.Свойство(Позиция, "quantity", 0);
		СтрокаТоваров.Цена = РаботаСJSON.Свойство(Позиция, "price", 0);
		СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;

	КонецЦикла;

КонецПроцедуры

// Проводит заказ. Если провести не удалось (например, не хватает товара),
// заказ сохраняется непроведенным, чтобы не потерять его, и выбрасывается исключение.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказМаркетплейса
//
Процедура ЗаписатьЗаказ(Заказ)

	ПолучитьСообщенияПользователю(Истина);

	Попытка
		Заказ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат;
	Исключение
		ТекстОшибки = ТекстСообщенийПользователю();
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;

	Если Не Заказ.ЭтоНовый() И ОбщиеРеквизитыЗаказа(Заказ.Ссылка).Проведен Тогда
		Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Заказ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Заказ сохранен без проведения: %1'"), ТекстОшибки);

КонецПроцедуры

#КонецОбласти

#Область ОтправкаСтатусов

// Отправляет статус заказа; при ошибке ставит заказ в очередь повторной отправки.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказМаркетплейса
//  Результат - Структура - см. НовыйРезультатОбмена.
//
Процедура ОтправитьСтатус(Заказ, Результат)

	Реквизиты = ОбщиеРеквизитыЗаказа(Заказ);
	КодСтатуса = Документы.ЗаказМаркетплейса.КодСтатуса(Реквизиты.Статус);
	Если ПустаяСтрока(КодСтатуса) Или КодСтатуса = "new" Тогда
		УдалитьИзОчереди(Заказ);
		Возврат;
	КонецЕсли;

	Попытка
		Настройки = НастройкиПодключения();
		Путь = СтрШаблон("/v1/orders/%1/status",
			КодироватьСтроку(Реквизиты.ИдентификаторЗаказа, СпособКодированияСтроки.КодировкаURL));
		ВыполнитьЗапрос(Настройки, "PATCH", Путь, Новый Структура("status", КодСтатуса));
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Ошибки.Добавить(СтрШаблон("%1: %2", Реквизиты.ИдентификаторЗаказа, ТекстОшибки));
		ПоставитьВОчередь(Заказ, ТекстОшибки);
		Возврат;
	КонецПопытки;

	Результат.Обработано = Результат.Обработано + 1;
	УдалитьИзОчереди(Заказ);

КонецПроцедуры

Процедура ПоставитьВОчередь(Заказ, ТекстОшибки)

	Запись = РегистрыСведений.ОчередьОтправкиСтатусов.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Прочитать();

	Запись.Заказ = Заказ;
	Запись.Попыток = Запись.Попыток + 1;
	Запись.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
	Запись.ПоследняяОшибка = ТекстОшибки;
	Запись.Записать();

КонецПроцедуры

Процедура УдалитьИзОчереди(Заказ)

	Набор = РегистрыСведений.ОчередьОтправкиСтатусов.СоздатьНаборЗаписей();
	Набор.Отбор.Заказ.Установить(Заказ);
	Набор.Записать();

КонецПроцедуры

#КонецОбласти

Функция ОстаткиДляВыгрузки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	НЕ Товары.ПометкаУдаления
	|	И Товары.Артикул <> """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТТовары.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТТовары)) КАК Остатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Артикул КАК Артикул,
	|	ВТТовары.Наименование КАК Наименование,
	|	ЕСТЬNULL(ВТОстатки.Количество, 0) КАК Количество
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТТовары.Ссылка = ВТОстатки.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Артикул";
	
	Остатки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("offer_id", Выборка.Артикул);
		Позиция.Вставить("stock", Макс(0, Цел(Выборка.Количество)));
		Остатки.Добавить(Позиция);
	КонецЦикла;
	
	Возврат Остатки;
	
КонецФункции

Функция ОбщиеРеквизитыЗаказа(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказ.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Заказ.Статус КАК Статус,
	|	Заказ.Проведен КАК Проведен
	|ИЗ
	|	Документ.ЗаказМаркетплейса КАК Заказ
	|ГДЕ
	|	Заказ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Реквизиты = Новый Структура("ИдентификаторЗаказа, Статус, Проведен");
	ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
	Возврат Реквизиты;

КонецФункции

#Область HTTP

// Параметры подключения из адреса вида http(s)://сервер[:порт][/путь].
//
// Возвращаемое значение:
//  Структура:
//   * Сервер - Строка
//   * Порт - Число
//   * Защищенное - Булево
//   * БазовыйПуть - Строка - без завершающего "/".
//   * Токен - Строка
//
Функция НастройкиПодключения()

	Адрес = СокрЛП(Константы.АдресСервисаМаркетплейса.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен адрес сервиса маркетплейса'");
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("Защищенное", СтрНачинаетсяС(НРег(Адрес), "https://"));
	Настройки.Вставить("Токен", СокрЛП(Константы.ТокенМаркетплейса.Получить()));

	ПозицияСхемы = СтрНайти(Адрес, "://");
	Если ПозицияСхемы > 0 Тогда
		Адрес = Сред(Адрес, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути > 0 Тогда
		Хост = Лев(Адрес, ПозицияПути - 1);
		БазовыйПуть = Сред(Адрес, ПозицияПути);
	Иначе
		Хост = Адрес;
		БазовыйПуть = "";
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(БазовыйПуть, "/") Цикл
		БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1);
	КонецЦикла;

	ПозицияПорта = СтрНайти(Хост, ":");
	Если ПозицияПорта > 0 Тогда
		Настройки.Вставить("Сервер", Лев(Хост, ПозицияПорта - 1));
		Настройки.Вставить("Порт", Число(Сред(Хост, ПозицияПорта + 1)));
	Иначе
		Настройки.Вставить("Сервер", Хост);
		Настройки.Вставить("Порт", ?(Настройки.Защищенное, 443, 80));
	КонецЕсли;
	Настройки.Вставить("БазовыйПуть", БазовыйПуть);

	Возврат Настройки;

КонецФункции

Функция ВыполнитьЗапрос(Настройки, Метод, Путь, Тело = Неопределено)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Настройки.Токен);

	Запрос = Новый HTTPЗапрос(Настройки.БазовыйПуть + Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(РаботаСJSON.ЗаписатьВСтроку(Тело),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	ЗащищенноеСоединение = ?(Настройки.Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	Соединение = Новый HTTPСоединение(Настройки.Сервер, Настройки.Порт, , , , 30, ЗащищенноеСоединение);
	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("%1 %2: HTTP %3 %4", Метод, Путь, Ответ.КодСостояния, Лев(ТекстОтвета, 500));
	КонецЕсли;

	Возврат РаботаСJSON.ПрочитатьИзСтроки(ТекстОтвета);

КонецФункции

#КонецОбласти

Процедура ЗаписатьВЖурнал(Направление, Операция, Результат)

	Запись = РегистрыСведений.ЖурналОбмена.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.Направление = Направление;
	Запись.Операция = Операция;
	Запись.Успешно = Результат.Ошибки.Количество() = 0;
	Запись.КоличествоОбъектов = Результат.Обработано;
	Запись.Сообщение = СтрСоединить(Результат.Ошибки, Символы.ПС);
	Запись.Записать();

КонецПроцедуры

Функция ТекстСообщенийПользователю()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

#КонецОбласти
