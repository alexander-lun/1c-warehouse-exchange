#Область ПрограммныйИнтерфейс

// Читает JSON из строки.
//
// Параметры:
//  ТекстJSON - Строка
//
// Возвращаемое значение:
//  Соответствие, Массив, Строка, Число, Булево, Неопределено - прочитанное значение.
//  Объекты JSON читаются в Соответствие, т.к. ключи могут не быть допустимыми именами свойств.
//
Функция ПрочитатьИзСтроки(ТекстJSON) Экспорт

	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

// Сериализует значение в строку JSON. Даты записываются в формате ISO 8601 без часового пояса.
//
// Параметры:
//  Значение - Структура, Соответствие, Массив, Строка, Число, Булево, Дата - данные для записи.
//
// Возвращаемое значение:
//  Строка - текст JSON.
//
Функция ЗаписатьВСтроку(Значение) Экспорт

	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение, Настройки);

	Возврат Запись.Закрыть();

КонецФункции

// Преобразует дату из строки ISO 8601 ("2026-10-20T12:30:00").
//
// Параметры:
//  ДатаISO - Строка - дата в формате ISO 8601.
//
// Возвращаемое значение:
//  Дата - пустая дата, если строку не удалось разобрать.
//
Функция ДатаИзСтроки(ДатаISO) Экспорт

	Если ПустаяСтрока(ДатаISO) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Возврат ПрочитатьДатуJSON(Лев(ДатаISO, 19), ФорматДатыJSON.ISO);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Возвращает значение по ключу соответствия или значение по умолчанию.
//
// Параметры:
//  Данные - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//  ПоУмолчанию - Произвольный - значение, если свойства нет или Данные не соответствие.
//
// Возвращаемое значение:
//  Произвольный
//
Функция Свойство(Данные, Ключ, ПоУмолчанию = Неопределено) Экспорт

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Данные.Получить(Ключ);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

#КонецОбласти
