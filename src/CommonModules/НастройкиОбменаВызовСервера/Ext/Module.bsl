#Область ПрограммныйИнтерфейс

// Устанавливает значения констант настроек обмена.
//
// Параметры:
//  Настройки - Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя константы.
//   * Значение - Строка - значение; приводится к типу константы.
//
// Возвращаемое значение:
//  Массив из Строка - имена констант, которые не входят в настройки обмена.
//
Функция УстановитьНастройки(Настройки) Экспорт

	Допустимые = СтрРазделить("АдресСервисаМаркетплейса,ТокенМаркетплейса,ТокенAPI,ДатаПоследнейЗагрузкиЗаказов", ",");
	Пропущенные = Новый Массив;

	НачатьТранзакцию();
	Попытка
		Для Каждого КлючИЗначение Из Настройки Цикл
			Если Допустимые.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
				Пропущенные.Добавить(КлючИЗначение.Ключ);
				Продолжить;
			КонецЕсли;
			ТипКонстанты = Метаданные.Константы[КлючИЗначение.Ключ].Тип;
			Если ТипКонстанты.СодержитТип(Тип("Дата")) Тогда
				Значение = РаботаСJSON.ДатаИзСтроки(КлючИЗначение.Значение);
			Иначе
				Значение = ТипКонстанты.ПривестиЗначение(КлючИЗначение.Значение);
			КонецЕсли;
			Константы[КлючИЗначение.Ключ].Установить(Значение);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Пропущенные;

КонецФункции

#КонецОбласти
