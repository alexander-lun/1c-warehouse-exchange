#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Показатели оборачиваемости по товарам за период - по той же схеме компоновки, что и отчет,
// поэтому цифры в API и в отчете совпадают.
//
// Параметры:
//  НачалоПериода - Дата
//  КонецПериода - Дата
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки по полям варианта «Основной»: Номенклатура, Артикул, НачальныйОстаток, Продажи,
//                    КонечныйОстаток, СреднийОстаток, ОборачиваемостьДней, ДнейПокрытия.
//
Функция ДанныеОборачиваемости(НачалоПериода, КонецПериода) Экспорт

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);

	Настройки = Компоновщик.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период",
		Новый СтандартныйПериод(НачалоДня(НачалоПериода), КонецДня(КонецПериода)));
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Нет);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
