		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Обороты.Номенклатура КАК Номенклатура,
	Обороты.Номенклатура.Артикул КАК Артикул,
	Обороты.КоличествоНачальныйОстаток КАК НачальныйОстаток,
	Обороты.КоличествоРасход КАК Продажи,
	Обороты.КоличествоКонечныйОстаток КАК КонечныйОстаток,
	(Обороты.КоличествоНачальныйОстаток + Обороты.КоличествоКонечныйОстаток) / 2 КАК СреднийОстаток,
	РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ) + 1 КАК ДнейВПериоде,
	0 КАК ОборачиваемостьДней,
	0 КАК ДнейПокрытия
ИЗ
	РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК Обороты</query>
