	</totalField>
	<totalField>
		<dataPath>ОборачиваемостьДней</dataPath>
		<expression>ВЫБОР КОГДА Сумма(Продажи) &gt; 0 ТОГДА Окр(Сумма(СреднийОстаток) * Максимум(ДнейВПериоде) / Сумма(Продажи), 1) КОНЕЦ</expression>
	</totalField>
	<totalField>
		<dataPath>ДнейПокрытия</dataPath>
		<expression>ВЫБОР КОГДА Сумма(Продажи) &gt; 0 ТОГДА Окр(Сумма(КонечныйОстаток) * Максимум(ДнейВПериоде) / Сумма(Продажи), 1) КОНЕЦ</expression>
	</totalField>
