#Область ОбработчикиСобытий

Процедура ПриНачалеРаботыСистемы()

	// Настройка без интерактивного входа:
	// /C "НастроитьОбмен;АдресСервисаМаркетплейса=http://host:port;ТокенМаркетплейса=...;ТокенAPI=..."
	Если СтрНачинаетсяС(ПараметрЗапуска, "НастроитьОбмен") Тогда
		НастроитьОбменИЗавершить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьОбменИЗавершить()

	Настройки = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(ПараметрЗапуска, ";", Ложь) Цикл
		ПозицияРавно = СтрНайти(Часть, "=");
		Если ПозицияРавно > 0 Тогда
			Настройки.Вставить(СокрЛП(Лев(Часть, ПозицияРавно - 1)), СокрЛП(Сред(Часть, ПозицияРавно + 1)));
		КонецЕсли;
	КонецЦикла;

	Пропущенные = НастройкиОбменаВызовСервера.УстановитьНастройки(Настройки);
	Если Пропущенные.Количество() > 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Пропущены неизвестные параметры'"), , СтрСоединить(Пропущенные, ", "));
	КонецЕсли;

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти
