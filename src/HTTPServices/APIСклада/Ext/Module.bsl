#Область ОбработчикиСобытий

Функция ОстаткиGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка
		Возврат ОтветJSON(200, Новый Структура("items", ДанныеОстатков()));
	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ОстатокТовараGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка
		Артикул = Запрос.ПараметрыURL.Получить("sku");
		Остатки = ДанныеОстатков(Артикул);
		Если Остатки.Количество() = 0 Тогда
			Возврат ОтветОшибка(404, СтрШаблон(НСтр("ru = 'Товар с артикулом %1 не найден'"), Артикул));
		КонецЕсли;
		Позиция = Остатки[0];
		Позиция.Вставить("cells", ОстаткиВЯчейках(Артикул));
		Возврат ОтветJSON(200, Позиция);
	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ЗаказыGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Статус = Неопределено;
		КодСтатуса = Запрос.ПараметрыЗапроса.Получить("status");
		Если ЗначениеЗаполнено(КодСтатуса) Тогда
			Статус = Документы.ЗаказМаркетплейса.СтатусПоКоду(КодСтатуса);
			Если Статус = Неопределено Тогда
				Возврат ОтветОшибка(400, СтрШаблон(НСтр("ru = 'Неизвестный статус %1'"), КодСтатуса));
			КонецЕсли;
		КонецЕсли;

		Лимит = 100;
		ЛимитСтрокой = Запрос.ПараметрыЗапроса.Получить("limit");
		Если ЗначениеЗаполнено(ЛимитСтрокой) Тогда
			Лимит = ЧислоИзСтроки(ЛимитСтрокой);
			Если Лимит < 1 Или Лимит > 1000 Тогда
				Возврат ОтветОшибка(400, НСтр("ru = 'Параметр limit должен быть от 1 до 1000'"));
			КонецЕсли;
		КонецЕсли;

		Возврат ОтветJSON(200, Новый Структура("orders", СписокЗаказов(Статус, Лимит)));

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ЗаказGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка
		Заказ = Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Запрос.ПараметрыURL.Получить("id"));
		Если Заказ = Неопределено Тогда
			Возврат ЗаказНеНайден(Запрос);
		КонецЕсли;
		Возврат ОтветJSON(200, ДанныеЗаказа(Заказ));
	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция СтатусЗаказаPUT(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Тело = ТелоЗапроса(Запрос);
		Если Тело = Неопределено Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Тело запроса должно быть объектом JSON'"));
		КонецЕсли;

		Статус = Документы.ЗаказМаркетплейса.СтатусПоКоду(РаботаСJSON.Свойство(Тело, "status", ""));
		Если Статус = Неопределено Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Не указан или неизвестен статус'"));
		КонецЕсли;

		Ссылка = Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Запрос.ПараметрыURL.Получить("id"));
		Если Ссылка = Неопределено Тогда
			Возврат ЗаказНеНайден(Запрос);
		КонецЕсли;

		Заказ = Ссылка.ПолучитьОбъект();
		Если Заказ.Статус = Статус Тогда
			Возврат ОтветJSON(200, ДанныеЗаказа(Ссылка));
		КонецЕсли;
		Если Документы.ЗаказМаркетплейса.ЭтоКонечныйСтатус(Заказ.Статус) Тогда
			Возврат ОтветОшибка(409, СтрШаблон(НСтр("ru = 'Заказ в статусе ""%1"", статус изменить нельзя'"), Заказ.Статус));
		КонецЕсли;

		Заказ.Статус = Статус;
		Если Не Заказ.Проведен Тогда
			Заказ.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ПолучитьСообщенияПользователю(Истина);
		Попытка
			Заказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Возврат ОтветОшибка(422, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		КонецПопытки;

		Данные = ДанныеЗаказа(Ссылка);
		Отправка = ОбменСМаркетплейсом.ОтправитьСтатусЗаказа(Ссылка);
		Данные.Вставить("marketplace_errors", Отправка.Ошибки);

		Возврат ОтветJSON(200, Данные);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ОбменPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Операция = Запрос.ПараметрыURL.Получить("operation");
		Если Операция = "pull-orders" Тогда
			Результат = ОбменСМаркетплейсом.ЗагрузитьЗаказы();
		ИначеЕсли Операция = "push-stock" Тогда
			Результат = ОбменСМаркетплейсом.ВыгрузитьОстатки();
		ИначеЕсли Операция = "push-statuses" Тогда
			Результат = ОбменСМаркетплейсом.ОтправитьОжидающиеСтатусы();
		Иначе
			Возврат ОтветОшибка(404, СтрШаблон(НСтр("ru = 'Неизвестная операция %1'"), Операция));
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Результат.Ошибки.Количество() = 0);
		Ответ.Вставить("processed", Результат.Обработано);
		Ответ.Вставить("created", Результат.Создано);
		Ответ.Вставить("updated", Результат.Обновлено);
		Ответ.Вставить("skipped", Результат.Пропущено);
		Ответ.Вставить("errors", Результат.Ошибки);

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ПоступленияPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Тело = ТелоЗапроса(Запрос);
		Позиции = РаботаСJSON.Свойство(Тело, "items");
		Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Нужен непустой массив items'"));
		КонецЕсли;

		ОшибкиПроверки = ПроверитьПозицииПоступления(Позиции);
		Если ОшибкиПроверки.Количество() > 0 Тогда
			Возврат ОтветОшибка(400, СтрСоединить(ОшибкиПроверки, "; "));
		КонецЕсли;

		ПолучитьСообщенияПользователю(Истина);
		НачатьТранзакцию();
		Попытка
			Поступление = СоздатьПоступление(Позиции);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Возврат ОтветОшибка(422, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		КонецПопытки;

		Ответ = Новый Структура;
		Ответ.Вставить("number", Поступление.Номер);
		Ответ.Вставить("date", Поступление.Дата);
		Ответ.Вставить("items", Поступление.Товары.Количество());

		Возврат ОтветJSON(201, Ответ);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ЯчейкиPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Ячейки = РаботаСJSON.Свойство(ТелоЗапроса(Запрос), "cells");
		Если ТипЗнч(Ячейки) <> Тип("Массив") Или Ячейки.Количество() = 0 Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Нужен непустой массив cells'"));
		КонецЕсли;

		Создано = 0;
		Обновлено = 0;
		НачатьТранзакцию();
		Попытка
			Для Каждого ДанныеЯчейки Из Ячейки Цикл
				Если ЗаписатьЯчейку(ДанныеЯчейки) Тогда
					Создано = Создано + 1;
				Иначе
					Обновлено = Обновлено + 1;
				КонецЕсли;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Возврат ОтветОшибка(400, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Возврат ОтветJSON(200, Новый Структура("created, updated", Создано, Обновлено));

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция РазмещенияPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		// Без тела - автоматическое размещение всего, что лежит в зоне приемки.
		Позиции = РаботаСJSON.Свойство(ТелоЗапроса(Запрос), "items");
		Если Позиции = Неопределено Тогда
			Размещение = Документы.РазмещениеТоваров.ТоварыДляРазмещенияИзЗоныПриемки();
		Иначе
			Размещение = РазмещениеИзЗапроса(Позиции);
			Если Размещение.Ошибки.Количество() > 0 Тогда
				Возврат ОтветОшибка(400, СтрСоединить(Размещение.Ошибки, "; "));
			КонецЕсли;
		КонецЕсли;

		Ответ = Новый Структура("number, items, errors", "", Новый Массив, Размещение.Ошибки);
		Если Размещение.Товары.Количество() = 0 Тогда
			Возврат ОтветJSON(?(Размещение.Ошибки.Количество() = 0, 200, 422), Ответ);
		КонецЕсли;

		ПолучитьСообщенияПользователю(Истина);
		Документ = Документы.РазмещениеТоваров.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Товары.Загрузить(Размещение.Товары);
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Возврат ОтветОшибка(422, ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		КонецПопытки;

		Ответ.number = Документ.Номер;
		Для Каждого СтрокаТоваров Из Документ.Товары Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("sku", СтрокаТоваров.Номенклатура.Артикул);
			Позиция.Вставить("from", Строка(СтрокаТоваров.ЯчейкаОтправитель));
			Позиция.Вставить("to", Строка(СтрокаТоваров.ЯчейкаПолучатель));
			Позиция.Вставить("quantity", СтрокаТоваров.Количество);
			Ответ.items.Добавить(Позиция);
		КонецЦикла;

		Возврат ОтветJSON(201, Ответ);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ОтборЗаказаPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Заказ = Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Запрос.ПараметрыURL.Получить("id"));
		Если Заказ = Неопределено Тогда
			Возврат ЗаказНеНайден(Запрос);
		КонецЕсли;

		Если Документы.ОтборТоваров.ОтборПоЗаказу(Заказ) <> Неопределено Тогда
			Возврат ОтветОшибка(409, НСтр("ru = 'Заказ уже отобран'"));
		КонецЕсли;

		Попытка
			Отбор = Документы.ОтборТоваров.СоздатьПоЗаказу(Заказ);
		Исключение
			Возврат ОтветОшибка(422, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Возврат ОтветJSON(201, ДанныеОтбора(Отбор.Ссылка, Запрос.ПараметрыURL.Получить("id")));

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ЛистОтбораGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Заказ = Документы.ЗаказМаркетплейса.НайтиПоИдентификатору(Запрос.ПараметрыURL.Получить("id"));
		Если Заказ = Неопределено Тогда
			Возврат ЗаказНеНайден(Запрос);
		КонецЕсли;

		Отбор = Документы.ОтборТоваров.ОтборПоЗаказу(Заказ);
		Если Отбор = Неопределено Тогда
			Возврат ОтветОшибка(404, НСтр("ru = 'Заказ еще не отобран'"));
		КонецЕсли;

		Если Запрос.ПараметрыЗапроса.Получить("format") = "json" Тогда
			Возврат ОтветJSON(200, ДанныеОтбора(Отбор, Запрос.ПараметрыURL.Получить("id")));
		КонецЕсли;

		Отборы = Новый Массив;
		Отборы.Добавить(Отбор);
		ТабличныйДокумент = Документы.ОтборТоваров.ПечатьЛистаОтбора(Отборы);
		ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
		ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
		УдалитьФайлы(ИмяФайла);

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
		Ответ.Заголовки.Вставить("Content-Disposition", "inline; filename=pick-list.pdf");
		Ответ.УстановитьТелоИзДвоичныхДанных(ДанныеФайла);
		Возврат Ответ;

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ОборачиваемостьGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
		КонецПериода = ТекущаяДатаСеанса();
		Для Каждого Имя Из СтрРазделить("from,to", ",") Цикл
			Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДатаПараметра = РаботаСJSON.ДатаИзСтроки(Значение + "T00:00:00");
			Если Не ЗначениеЗаполнено(ДатаПараметра) Тогда
				Возврат ОтветОшибка(400, СтрШаблон(НСтр("ru = 'Параметр %1: ожидается дата ГГГГ-ММ-ДД'"), Имя));
			КонецЕсли;
			Если Имя = "from" Тогда
				НачалоПериода = ДатаПараметра;
			Иначе
				КонецПериода = ДатаПараметра;
			КонецЕсли;
		КонецЦикла;
		Если НачалоПериода > КонецПериода Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Начало периода позже конца'"));
		КонецЕсли;

		Позиции = Новый Массив;
		Данные = Отчеты.ОборачиваемостьТоваров.ДанныеОборачиваемости(НачалоПериода, КонецПериода);
		Для Каждого СтрокаДанных Из Данные Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("sku", СтрокаДанных.Артикул);
			Позиция.Вставить("name", Строка(СтрокаДанных.Номенклатура));
			Позиция.Вставить("opening", ЧислоИлиNull(СтрокаДанных.НачальныйОстаток));
			Позиция.Вставить("sold", ЧислоИлиNull(СтрокаДанных.Продажи));
			Позиция.Вставить("closing", ЧислоИлиNull(СтрокаДанных.КонечныйОстаток));
			Позиция.Вставить("average", ЧислоИлиNull(СтрокаДанных.СреднийОстаток));
			Позиция.Вставить("turnover_days", ЧислоИлиNull(СтрокаДанных.ОборачиваемостьДней));
			Позиция.Вставить("cover_days", ЧислоИлиNull(СтрокаДанных.ДнейПокрытия));
			Позиции.Добавить(Позиция);
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("from", Формат(НачалоПериода, "ДФ=yyyy-MM-dd"));
		Ответ.Вставить("to", Формат(КонецПериода, "ДФ=yyyy-MM-dd"));
		Ответ.Вставить("items", Позиции);

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Данные

// Создает или обновляет ячейку по адресу.
//
// Параметры:
//  ДанныеЯчейки - Соответствие - address, route_order.
//
// Возвращаемое значение:
//  Булево - Истина, если ячейка создана.
//
Функция ЗаписатьЯчейку(ДанныеЯчейки)

	Адрес = СокрЛП(РаботаСJSON.Свойство(ДанныеЯчейки, "address", ""));
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан address'");
	КонецЕсли;

	Ссылка = Справочники.Ячейки.НайтиПоНаименованию(Адрес, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Ячейка = Ссылка.ПолучитьОбъект();
	Иначе
		Ячейка = Справочники.Ячейки.СоздатьЭлемент();
		Ячейка.Наименование = Адрес;
	КонецЕсли;
	Ячейка.ПорядокОбхода = РаботаСJSON.Свойство(ДанныеЯчейки, "route_order", Ячейка.ПорядокОбхода);
	Ячейка.Записать();

	Возврат Не ЗначениеЗаполнено(Ссылка);

КонецФункции

// Строки размещения из тела запроса: sku, from, to, quantity. Ячейки ищутся по адресу.
//
// Параметры:
//  Позиции - Массив из Соответствие
//
// Возвращаемое значение:
//  Структура - см. Документы.РазмещениеТоваров.ТоварыДляРазмещенияИзЗоныПриемки.
//
Функция РазмещениеИзЗапроса(Позиции)

	Результат = Новый Структура("Товары, Ошибки", Новый ТаблицаЗначений, Новый Массив);
	Результат.Товары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Товары.Колонки.Добавить("ЯчейкаОтправитель", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	Результат.Товары.Колонки.Добавить("ЯчейкаПолучатель", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	Результат.Товары.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Если ТипЗнч(Позиции) <> Тип("Массив") Тогда
		Результат.Ошибки.Добавить(НСтр("ru = 'items должен быть массивом'"));
		Возврат Результат;
	КонецЕсли;

	Для Индекс = 0 По Позиции.ВГраница() Цикл

		Позиция = Позиции[Индекс];
		СтрокаТоваров = Результат.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",
			Строка(РаботаСJSON.Свойство(Позиция, "sku", "")));
		СтрокаТоваров.ЯчейкаОтправитель = Справочники.Ячейки.НайтиПоНаименованию(
			Строка(РаботаСJSON.Свойство(Позиция, "from", "")), Истина);
		СтрокаТоваров.ЯчейкаПолучатель = Справочники.Ячейки.НайтиПоНаименованию(
			Строка(РаботаСJSON.Свойство(Позиция, "to", "")), Истина);
		СтрокаТоваров.Количество = РаботаСJSON.Свойство(Позиция, "quantity", 0);

		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'items[%1]: товар не найден'"), Индекс));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТоваров.ЯчейкаОтправитель)
			Или Не ЗначениеЗаполнено(СтрокаТоваров.ЯчейкаПолучатель) Тогда
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'items[%1]: ячейка не найдена'"), Индекс));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДанныеОтбора(Отбор, ИдентификаторЗаказа)

	Позиции = Новый Массив;
	Для Каждого СтрокаЛиста Из Документы.ОтборТоваров.СтрокиЛистаОтбора(Отбор) Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("cell", СтрокаЛиста.АдресЯчейки);
		Позиция.Вставить("sku", СтрокаЛиста.Артикул);
		Позиция.Вставить("name", Строка(СтрокаЛиста.Номенклатура));
		Позиция.Вставить("quantity", СтрокаЛиста.Количество);
		Позиции.Добавить(Позиция);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("number", Отбор.Номер);
	Данные.Вставить("order_id", ИдентификаторЗаказа);
	Данные.Вставить("items", Позиции);

	Возврат Данные;

КонецФункции

Функция ОстаткиВЯчейках(Артикул)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					Товары.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура КАК Товары
	|				ГДЕ
	|					Товары.Артикул = &Артикул)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ячейки.Наименование КАК Адрес,
	|	ВТОстатки.Количество КАК Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Ячейки КАК Ячейки
	|		ПО ВТОстатки.Ячейка = Ячейки.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ячейки.ПорядокОбхода,
	|	Адрес";
	Запрос.УстановитьПараметр("Артикул", Артикул);

	Ячейки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ячейки.Добавить(Новый Структура("cell, quantity", Выборка.Адрес, Выборка.Количество));
	КонецЦикла;

	Возврат Ячейки;

КонецФункции

Функция ДанныеОстатков(Артикул = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	НЕ Товары.ПометкаУдаления
	|	И &УсловиеОтбора
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТТовары.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТТовары)) КАК Остатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Артикул КАК Артикул,
	|	ВТТовары.Наименование КАК Наименование,
	|	ЕСТЬNULL(ВТОстатки.Количество, 0) КАК Количество
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТТовары.Ссылка = ВТОстатки.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Артикул";
	
	Если Артикул = Неопределено Тогда
		Запрос.УстановитьПараметр("УсловиеОтбора", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "Товары.Артикул = &Артикул");
		Запрос.УстановитьПараметр("Артикул", Артикул);
	КонецЕсли;
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("sku", Выборка.Артикул);
		Позиция.Вставить("name", Выборка.Наименование);
		Позиция.Вставить("quantity", Выборка.Количество);
		Результат.Добавить(Позиция);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СписокЗаказов(Статус, Лимит)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Заказ.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Заказ.Номер КАК Номер,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Статус КАК Статус,
	|	Заказ.СуммаДокумента КАК СуммаДокумента,
	|	Заказ.Проведен КАК Проведен
	|ИЗ
	|	Документ.ЗаказМаркетплейса КАК Заказ
	|ГДЕ
	|	НЕ Заказ.ПометкаУдаления
	|	И &УсловиеОтбора
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 100", "ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0"));
	Если Статус = Неопределено Тогда
		Запрос.УстановитьПараметр("УсловиеОтбора", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "Заказ.Статус = &Статус");
		Запрос.УстановитьПараметр("Статус", Статус);
	КонецЕсли;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ПредставлениеЗаказа(Выборка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДанныеЗаказа(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказ.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Заказ.Номер КАК Номер,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Статус КАК Статус,
	|	Заказ.СуммаДокумента КАК СуммаДокумента,
	|	Заказ.Проведен КАК Проведен
	|ИЗ
	|	Документ.ЗаказМаркетплейса КАК Заказ
	|ГДЕ
	|	Заказ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товар.Артикул КАК Артикул,
	|	Товар.Наименование КАК Наименование,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЗаказМаркетплейса.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товар
	|		ПО Товары.Номенклатура = Товар.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Заказ);

	Результаты = Запрос.ВыполнитьПакет();

	Шапка = Результаты[0].Выбрать();
	Шапка.Следующий();
	Данные = ПредставлениеЗаказа(Шапка);

	Позиции = Новый Массив;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("sku", Выборка.Артикул);
		Позиция.Вставить("name", Выборка.Наименование);
		Позиция.Вставить("quantity", Выборка.Количество);
		Позиция.Вставить("price", Выборка.Цена);
		Позиция.Вставить("amount", Выборка.Сумма);
		Позиции.Добавить(Позиция);
	КонецЦикла;
	Данные.Вставить("items", Позиции);

	Возврат Данные;

КонецФункции

Функция ПредставлениеЗаказа(Выборка)

	Данные = Новый Структура;
	Данные.Вставить("id", Выборка.ИдентификаторЗаказа);
	Данные.Вставить("number", Выборка.Номер);
	Данные.Вставить("date", Выборка.Дата);
	Данные.Вставить("status", Документы.ЗаказМаркетплейса.КодСтатуса(Выборка.Статус));
	Данные.Вставить("amount", Выборка.СуммаДокумента);
	Данные.Вставить("posted", Выборка.Проведен);

	Возврат Данные;

КонецФункции

Функция ПроверитьПозицииПоступления(Позиции)

	Ошибки = Новый Массив;

	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Позиция = Позиции[Индекс];
		Артикул = РаботаСJSON.Свойство(Позиция, "sku", "");
		Количество = РаботаСJSON.Свойство(Позиция, "quantity", 0);
		Если ТипЗнч(Артикул) <> Тип("Строка") Или ПустаяСтрока(Артикул) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'items[%1]: не указан sku'"), Индекс));
		КонецЕсли;
		Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'items[%1]: quantity должно быть положительным числом'"), Индекс));
		КонецЕсли;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// Создает и проводит поступление. Новые товары создаются по артикулу, для них обязательно наименование.
//
// Параметры:
//  Позиции - Массив из Соответствие - позиции из тела запроса (sku, name, quantity).
//
// Возвращаемое значение:
//  ДокументОбъект.ПоступлениеТоваров
//
Функция СоздатьПоступление(Позиции)

	Документ = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();

	Для Каждого Позиция Из Позиции Цикл

		Артикул = СокрЛП(Позиция.Получить("sku"));
		Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);

		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Наименование = СокрЛП(РаботаСJSON.Свойство(Позиция, "name", ""));
			Если ПустаяСтрока(Наименование) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Товар %1 не найден, для создания укажите name'"), Артикул);
			КонецЕсли;
			Товар = Справочники.Номенклатура.СоздатьЭлемент();
			Товар.Наименование = Наименование;
			Товар.Артикул = Артикул;
			Товар.Записать();
			Номенклатура = Товар.Ссылка;
		КонецЕсли;

		СтрокаТоваров = Документ.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Номенклатура;
		СтрокаТоваров.Количество = Позиция.Получить("quantity");

	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ;

КонецФункции

#КонецОбласти

#Область HTTP

Функция ПроверитьДоступ(Запрос)

	Токен = СокрЛП(Константы.ТокенAPI.Получить());

	// Заголовок Authorization веб-сервер 1С использует для аутентификации пользователя базы,
	// поэтому ключ API передается в X-Api-Key.
	Ключ = "";
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = "x-api-key" Тогда
			Ключ = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Токен) Или Ключ <> Токен Тогда
		Возврат ОтветОшибка(401, НСтр("ru = 'Неверный или отсутствующий ключ API (заголовок X-Api-Key)'"));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ТелоЗапроса(Запрос)

	Попытка
		Тело = РаботаСJSON.ПрочитатьИзСтроки(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Тело) = Тип("Соответствие"), Тело, Неопределено);

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(РаботаСJSON.ЗаписатьВСтроку(Данные),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодСостояния, Текст)

	Возврат ОтветJSON(КодСостояния, Новый Структура("error", Текст));

КонецФункции

Функция ЗаказНеНайден(Запрос)

	Возврат ОтветОшибка(404, СтрШаблон(НСтр("ru = 'Заказ %1 не найден'"), Запрос.ПараметрыURL.Получить("id")));

КонецФункции

Функция ВнутренняяОшибка(Информация)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'API склада'"), УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

	Возврат ОтветОшибка(500, ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));

КонецФункции

// Сообщения, выданные при записи объекта (например, о нехватке товара), информативнее текста исключения.
//
// Параметры:
//  Информация - ИнформацияОбОшибке
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибкиЗаписи(Информация)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Если Тексты.Количество() = 0 Тогда
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация);
	КонецЕсли;

	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

// Показатель, который не вычисляется (например, оборачиваемость товара без продаж), в JSON выводится как null.
//
// Параметры:
//  Значение - Число, Null
//
// Возвращаемое значение:
//  Число, Неопределено
//
Функция ЧислоИлиNull(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, Неопределено);

КонецФункции

Функция ЧислоИзСтроки(Значение)

	ОписаниеТипа = Новый ОписаниеТипов("Число");
	Возврат ОписаниеТипа.ПривестиЗначение(Значение);

КонецФункции

